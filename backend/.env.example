# Database connection
# Default: Local SQLite (runs immediately without needing PostgreSQL installed)
DATABASE_URL=sqlite:///./pipelineguard.db

# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pipelineguard

# Authentication settings (Default credentials: admin / admin123)
PIPELINEGUARD_JWT_SECRET=pipelineguard_secret_jwt_key_at_least_32_chars_long!
PIPELINEGUARD_DASHBOARD_USERNAME=admin
PIPELINEGUARD_DASHBOARD_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$lAD0FPqRn15IEoLMccULdg$Oze8I09A5z8/9quAKRcQBLTTJwALHs595jEIRK4s9Xk
PIPELINEGUARD_SCANNER_API_TOKEN=pipelineguard_scanner_token_at_least_32_chars_long!
PIPELINEGUARD_JWT_EXPIRY_MINUTES=60
